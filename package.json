{
  "name": "gang-of-four",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "npm run demo -w @gof/server --",
    "dev:server": "npm run dev -w @gof/server",
    "dev": "concurrently -n serveur,client -c green,cyan \"npm run dev -w @gof/server\" \"npm run dev -w @gof/client\"",
    "build": "npm run build -w @gof/client && npm run build -w @gof/server",
    "start": "node dist/serveur/main.js",
    "start:dev": "npm run start -w @gof/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
